{
  "expo": {
    "name": "สมบัติทัวร์",
    "slug": "sombat-tour-dashboard",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/sombattourbg.png",
      "resizeMode": "contain",
      "backgroundColor": "#16234A"
    },
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#16234A"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "name": "โปรแกรมซ่อมบำรุง",
      "shortName": "โปรแกรมซ่อมบำรุง",
      "lang": "th",
      "themeColor": "#16234A",
      "backgroundColor": "#16234A",
      "description": "โปรแกรมซ่อมบำรุง"
    },
    "plugins": [
      "expo-asset"
    ]
  }
}
